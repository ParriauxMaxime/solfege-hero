{
  "name": "solfege",
  "version": "0.1.0",
  "description": "Note-reading trainer PWA",
  "scripts": {
    "test": "vitest run",
    "dev": "node scripts/build-score-index.mjs && vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "node scripts/build-score-index.mjs && node scripts/og-images.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "og": "node scripts/og-images.mjs --force",
    "check:og": "node scripts/check-og.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "type": "module",
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "private": true,
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  }
}
